<!-- Footer -->
<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h4>Chonglers Guild</h4>
        <p>Elite World of Warcraft guild dedicated to excellence, camaraderie, and epic adventures in Azeroth.</p>
      </div>
      
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><%= link_to "Gallery", root_path + "#gallery" %></li>
          <li><%= link_to "Join Us", root_path + "#join" %></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Account</h4>
        <ul>
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <li><%= link_to "Admin Panel", admin_dashboard_path %></li>
            <% end %>
            <li><%= button_to "Logout", destroy_user_session_path, method: :delete, data: { turbo: false }, form: { style: "display: inline;" }, class: "footer-logout-btn" %></li>
          <% else %>
            <li class="footer-auth-btn">
              <%= button_to user_discord_omniauth_authorize_path, method: :post, data: { turbo: false }, form: { style: "display: inline;" }, class: "footer-discord-signin-btn" do %>
                <%= image_tag "discord-icon.svg", alt: "Discord", width: 16, height: 16 %>
                <span>Sign In with Discord</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Connect</h4>
        <div class="footer-discord-actions">
          <a href="https://discord.gg/qthA2MJ3" target="_blank" class="footer-discord-server-btn">
            <%= image_tag "discord-icon.svg", alt: "Discord", width: 18, height: 18 %>
            <span>Join the Discord Server</span>
          </a>
          <% unless user_signed_in? %>
            <%= link_to new_user_registration_path, class: "footer-discord-signup-btn" do %>
              <%= image_tag "discord-icon.svg", alt: "Discord", width: 16, height: 16 %>
              <span>Sign Up with Discord</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; 2025 Chonglers Guild. All rights reserved. | World of Warcraft is a trademark of Blizzard Entertainment.</p>
    </div>
  </div>
</footer>
