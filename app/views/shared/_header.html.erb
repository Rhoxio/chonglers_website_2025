<!-- Navigation -->
<nav>
  <div class="container">
    <div class="nav-content">
      <div class="logo">
        <%= link_to "Chonglers", root_path %>
      </div>
      <ul class="nav-links">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Gallery", root_path + "#gallery" %></li>
        <li><%= link_to "Features", root_path + "#features" %></li>
        <li><%= link_to "Join Us", root_path + "#join" %></li>
        <% if user_signed_in? %>
          <li><%= link_to "Profile", edit_user_registration_path %></li>
          <% if current_user.admin? %>
            <li><%= link_to "Admin", admin_dashboard_path %></li>
          <% end %>
          <li><%= button_to "Logout", destroy_user_session_path, method: :delete, data: { turbo: false }, form: { style: "display: inline;" }, class: "logout-btn" %></li>
        <% else %>
          <li><%= link_to "Login", new_user_session_path %></li>
          <li><%= link_to "Sign Up", new_user_registration_path %></li>
          <li><%= button_to user_discord_omniauth_authorize_path, method: :post, data: { turbo: false }, form: { style: "display: inline;" }, class: "discord-login-btn" do %>
            <%= image_tag "discord-icon.svg", alt: "Discord", width: 20, height: 20 %>
            <span>Discord</span>
          <% end %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
