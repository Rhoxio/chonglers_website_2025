<!-- Navigation -->
<nav>
  <div class="container">
    <div class="nav-content">
      <div class="logo">
        <%= link_to "Chonglers", root_path %>
      </div>
      <ul class="nav-links">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Gallery", root_path + "#gallery" %></li>
        <li><%= link_to "Features", root_path + "#features" %></li>
