<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password - Chonglers</title>
  <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
</head>
<body>
  <a href="<%= root_path %>" class="back-link">← Back to Home</a>
  
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">Chonglers</div>
        <h1 class="auth-title">Change Password</h1>
        <p class="auth-subtitle">Enter your new password</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="field">
          <%= f.label :password, "New password" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Enter new password" %>
          <% if @minimum_password_length %>
            <div class="password-requirements">
              (<%= @minimum_password_length %> characters minimum)
            </div>
          <% end %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, "Confirm new password" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password" %>
        </div>

        <div class="actions">
          <%= f.submit "Change Password", class: "btn-primary" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</body>
</html>