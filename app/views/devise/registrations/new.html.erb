<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join Chonglers - Sign Up</title>
  <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
</head>
<body>
  <a href="<%= root_path %>" class="back-link">← Back to Home</a>
  
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">Chonglers</div>
        <h1 class="auth-title">Join the Guild</h1>
        <p class="auth-subtitle">Create your account to start your adventure</p>
      </div>

      <div class="discord-only-signup">
        <div class="signup-message">
          <h3>Join Chonglers with Discord</h3>
          <p>We use Discord for all guild communication and coordination. Sign up with your Discord account to get started!</p>
        </div>
      </div>


      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</body>
</html>