<% content_for :title, "Manage Images - Admin" %>
<%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
  <div class="admin-container">
    <a href="<%= admin_dashboard_path %>" class="back-link">← Back to Admin Dashboard</a>

    <div class="admin-header">
      <h1 class="admin-title">Manage Images</h1>
      <p class="admin-subtitle">Upload and manage guild images</p>
      <p class="stats-info"><%= @images_count %> images total</p>
    </div>

    <div class="admin-nav">
      <%= link_to "Dashboard", admin_dashboard_path %>
      <%= link_to "Manage Users", admin_users_path %>
      <%= link_to "Manage Images", admin_images_path, class: "active" %>
    </div>

    <div class="upload-section">
      <%= link_to "Upload New Image", new_admin_image_path, class: "upload-btn" %>
    </div>

    <% if @images.any? %>
      <div class="images-grid">
        <% @images.each do |image| %>
          <div class="image-card">
            <img src="<%= image.admin_thumbnail %>" alt="<%= image.title %>" class="image-preview">
            <div class="image-info">
              <h3 class="image-title"><%= image.title %></h3>
              <% if image.description.present? %>
                <p class="image-description"><%= truncate(image.description, length: 100) %></p>
              <% end %>
              <div class="image-actions">
                <%= link_to "View", admin_image_path(image), class: "btn-view" %>
                <%= link_to "Delete", admin_image_path(image), method: :delete,
                           confirm: "Are you sure you want to delete this image?",
                           class: "btn-delete" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>No Images Yet</h3>
        <p>Upload your first image to get started!</p>
      </div>
    <% end %>
  </div>