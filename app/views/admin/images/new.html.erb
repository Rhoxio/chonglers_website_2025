<% content_for :title, "Upload Image - Admin" %>
<%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>

<div class="admin-container">
  <a href="<%= admin_images_path %>" class="back-link">← Back to Images</a>

  <div class="admin-header">
    <h1 class="admin-title">Upload New Image</h1>
    <p class="admin-subtitle">Add a new image to the guild gallery</p>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-error">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="upload-form">
    <%= form_with(model: [:admin, @image], local: true, multipart: true) do |form| %>
      <div class="form-group">
        <%= form.label :file, "Select Image", class: "form-label" %>
        <%= form.file_field :file, accept: "image/*", required: true, class: "file-input" %>
        <p class="form-hint">Choose a JPG, PNG, or GIF file (max 10MB)</p>
      </div>

      <div class="form-group">
        <%= form.label :title, "Title", class: "form-label" %>
        <%= form.text_field :title, class: "form-input", placeholder: "Enter image title" %>
        <p class="form-hint">A descriptive title for the image</p>
      </div>

      <div class="form-group">
        <%= form.label :description, "Description (Optional)", class: "form-label" %>
        <%= form.text_area :description, class: "form-textarea", placeholder: "Enter image description" %>
        <p class="form-hint">Optional description of the image</p>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", admin_images_path, class: "btn-secondary" %>
        <%= form.submit "Upload Image", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>