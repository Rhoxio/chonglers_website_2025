<!DOCTYPE html>
<html>
  <head>
    <title>ChonglersWebsite2025</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "home", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render 'shared/header' %>

    <div id="flash-messages">
      <% if notice %>
        <div class="flash-message flash-notice" data-controller="flash" data-flash-auto-hide-value="5000">
          <span class="flash-text"><%= notice %></span>
          <button class="flash-close" data-action="click->flash#close">&times;</button>
        </div>
      <% end %>
      <% if alert %>
        <div class="flash-message flash-alert" data-controller="flash" data-flash-auto-hide-value="5000">
          <span class="flash-text"><%= alert %></span>
          <button class="flash-close" data-action="click->flash#close">&times;</button>
        </div>
      <% end %>
    </div>

    <%= yield %>
    
    <%= render 'shared/footer' %>
  </body>
</html>
