<!-- Hero Section -->
  <section id="home" class="hero" data-controller="home">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-content">
        <h1>Chonglers</h1>
        <p>Elite World of Warcraft guild dedicated to excellence, camaraderie, and epic adventures in Azeroth</p>
        <a href="https://discord.gg/qthA2MJ3" target="_blank" class="discord-server-btn">
          <%= image_tag "discord-icon.svg", alt: "Discord", width: 24, height: 24 %>
          <span>Join the Discord Server</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="gallery" class="gallery-section">
    <div class="container">
      <h2 class="section-title">Our Adventures</h2>
      <div class="gallery-grid">
        <% if @gallery_images.any? %>
          <% @gallery_images.each_with_index do |image, index| %>
            <%= link_to show_modal_image_path(image),
                        data: { turbo_method: :get, turbo_stream: true },
                        class: "gallery-item" do %>
              <img src="<%= image.gallery_thumbnail %>" alt="<%= image.title %>">
              <div class="gallery-overlay">
                <h3><%= image.title %></h3>
                <% if image.description.present? %>
                  <p><%= truncate(image.description, length: 60) %></p>
                <% else %>
                  <p>Guild adventure memories</p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <!-- Fallback to placeholder content if no images uploaded yet -->
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Raid Encounter">
            <div class="gallery-overlay">
              <h3>Epic Raids</h3>
              <p>Conquering the most challenging content together</p>
            </div>
          </div>
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="PvP Battles">
            <div class="gallery-overlay">
              <h3>PvP Domination</h3>
              <p>Victory in battlegrounds and arenas</p>
            </div>
          </div>
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Guild Events">
            <div class="gallery-overlay">
              <h3>Guild Events</h3>
              <p>Fun activities and community building</p>
            </div>
          </div>
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1518709268805-4e9042af2176?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Achievements">
            <div class="gallery-overlay">
              <h3>Legendary Achievements</h3>
              <p>Unlocking rare titles and mounts</p>
            </div>
          </div>
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Mythic+">
            <div class="gallery-overlay">
              <h3>Mythic+ Mastery</h3>
              <p>Pushing keys to the limit</p>
            </div>
          </div>
          <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Community">
            <div class="gallery-overlay">
              <h3>Strong Community</h3>
              <p>Friendships that last beyond the game</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-label">Active Members</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">15</div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">100%</div>
          <div class="stat-label">Raid Completion</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Support</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="features-section">
    <div class="container">
      <h2 class="section-title">Why Choose Chonglers?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">⚔️</div>
          <h3>Elite Raiding</h3>
          <p>Progressive raiding with experienced leadership and dedicated members. We clear content efficiently while maintaining a fun atmosphere.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🏆</div>
          <h3>Competitive PvP</h3>
          <p>Regular battleground groups, arena teams, and world PvP events. Climb the ranks with skilled teammates.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎯</div>
          <h3>Mythic+ Focus</h3>
          <p>Weekly keystone runs, coaching for new players, and pushing high keys with optimized compositions.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👥</div>
          <h3>Active Community</h3>
          <p>Discord server with voice channels, guild events, and a welcoming environment for players of all skill levels.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📚</div>
          <h3>Knowledge Sharing</h3>
          <p>Class guides, strategy discussions, and mentorship programs to help everyone improve their gameplay.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎮</div>
          <h3>Fun Events</h3>
          <p>Transmog contests, mount farming, achievement runs, and social events to build lasting friendships.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Join Section -->
  <section id="join" class="join-section">
    <div class="container">
      <div class="join-content">
        <h2>Ready to Join?</h2>
        <p>Whether you're a seasoned veteran or new to World of Warcraft, Chonglers welcomes dedicated players who share our passion for excellence and community.</p>
        <div class="discord-cta">
          <a href="https://discord.gg/qthA2MJ3" target="_blank" class="discord-server-btn">
            <%= image_tag "discord-icon.svg", alt: "Discord", width: 24, height: 24 %>
            <span>Join the Discord Server</span>
          </a>
          <p class="discord-subtitle">Connect with guild members, join raids, and be part of our community!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal container for Turbo Stream updates -->
  <div id="modal_container"></div>

